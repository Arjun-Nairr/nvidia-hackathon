# Copy to secrets/local.env (same folder). secrets/local.env is git-ignored. Never paste keys into chat, logs or HANDOUT.md.
# Provider: openai-codex (ChatGPT/Codex subscription, development) or nebius-token-factory (NVIDIA models, costs credits)
LLM_PROVIDER=openai-codex
# openai-codex: REQUIRED after login_codex.bat - pick an id printed by list_models.bat (no default; ids are never guessed).
# nebius-token-factory: optional; defaults to NEBIUS_MODEL below.
LLM_MODEL=
# Nebius only:
NEBIUS_API_KEY=
NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b

# ScrapeCreators (Facebook Marketplace diagnostic, ticket 02; scripts/marketplace_check.py). Your key from scrapecreators.com; read only by that script.
SCRAPECREATORS_API_KEY=
